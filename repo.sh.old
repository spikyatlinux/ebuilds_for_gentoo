#!/usr/bin/env bash
# All-In-One Gentoo Overlay Manager by SpikyAtLinux

# --- Colors ---
GREEN='\033[01;32m'
RED='\033[01;31m'
YELLOW='\033[01;33m'
NC='\033[00m'

SCRIPT_NAME=$(basename "$0")
REPO_DIR=$(pwd)
# Lese Repo-Namen für egencache aus, Fallback ist 'spikyatlinux'
REPO_NAME=$(cat profiles/repo_name 2>/dev/null || echo "spikyatlinux")

show_help() {
    echo -e "${GREEN}AIO Gentoo Overlay Manager${NC}"
    echo "Usage: ./$SCRIPT_NAME [COMMAND]"
    echo ""
    echo "Commands:"
    echo "  format    Repariert Copyrights, Tabs, Whitespaces und PYTHON_COMPAT."
    echo "  manifest  Bereinigt alte Manifest-Einträge und erstellt Digests neu."
    echo "  metadata  Generiert fehlende metadata.xml und Remote-IDs."
    echo "  cache     Aktualisiert egencache (pkg-desc, use-local, changelogs)."
    echo "  check     Sucht nach Duplikaten im Main-Tree und führt pkgcheck aus."
    echo "  upload    Setzt Berechtigungen (portage:portage), fragt nach Commit-Msg & pusht."
    echo "  reinit    Löscht .git, initialisiert neu und erzwingt einen Force-Push."
    echo "  all       Führt format -> manifest -> cache -> check aus."
    echo ""
}

# ---------------------------------------------------------
# 1. Formatierung, Copyrights und Python Compat
# ---------------------------------------------------------
cmd_format() {
    echo -e "${GREEN}Formatiere Ebuilds und aktualisiere Metadaten...${NC}"

    # Whitespaces am Ende trimmen
    find . -type f | grep -v -e "\.git" -e "eclass" -e "metadata" -e "profiles" | while read -r file; do
	if file "${file}" | grep -q 'text'; then
	    sed -i -e 's/[ \t]*$//' "${file}"
	fi
    done

    # Ebuilds anpassen
    find . -name "*.ebuild" | while read -r ebuild; do
	# 1. Alte Header löschen
	sed -i '/^# Copyright/d' "${ebuild}"
	sed -i '/^# Distributed/d' "${ebuild}"

	# 2. Neue Header einfügen
	sed -i "1s/^/# Distributed under the terms of the GNU General Public License v2\n/" "${ebuild}"
	sed -i "1s/^/# Copyright 1999-$(date +%Y) Gentoo Authors\n/" "${ebuild}"

	# 3. Python Compat pushen (pkgcheck mahnt python3_15 an)
	sed -i 's+^PYTHON_COMPAT=.*+PYTHON_COMPAT=( python3_{12..15} )+g' "${ebuild}"

	# 4. Leere Variablen restlos löschen (IUSE="", DEPEND="" etc.)
	sed -i -E '/^(IUSE|DEPEND|RDEPEND|BDEPEND|PDEPEND|SRC_URI|KEYWORDS)=""$/d' "${ebuild}"

	# 5. Punkt am Ende der DESCRIPTION entfernen
	sed -i -E 's/^(DESCRIPTION=".*)\."$/\1"/' "${ebuild}"

	# 6. Falsche Live-Ebuild Operatoren fixen (=pkg-9999 -> ~pkg-9999)
    sed -i -E 's/="=([^"]*-9999)"/="~\1"/g' "${ebuild}"
    sed -i -E "s/='=([^']*-9999)'/='~\1'/g" "${ebuild}"

	# 7. Unquoted Variables schützen ($S -> "${S}")
	sed -i -E 's/(^|[[:space:]])\$S([[:space:]]|$)/\1"${S}"\2/g' "${ebuild}"
	sed -i -E 's/(^|[[:space:]])\$D([[:space:]]|$)/\1"${D}"\2/g' "${ebuild}"
	sed -i -E 's/(^|[[:space:]])\$DISTDIR([[:space:]]|$)/\1"${DISTDIR}"\2/g' "${ebuild}"

	# 8. Leading Whitespaces (Spaces zu Tabs am Zeilenanfang konvertieren, 4 Spaces = 1 Tab)
	sed -i -e ':a' -e 's/^\(\t*\)    /\1\t/;ta' "${ebuild}"
    done
    echo "Ebuild-Header, Variablen und Formatierungen wurden aktualisiert."
}

# ---------------------------------------------------------
# 2. Manifests bereinigen und neu erstellen (Digest)
# ---------------------------------------------------------
cmd_manifest() {
    echo -e "${GREEN}Bereinige Thin-Manifests und generiere Digests...${NC}"

    # Clean Thin Manifest
    for dir in $(find . -maxdepth 2 -mindepth 2 -type d | grep -v ".git"); do
	local m="${dir}/Manifest"
	if [[ -f "${m}" ]]; then
	    sed -i -e '/ebuild/d' -e '/metadata/d' -e '/ChangeLog/d' "${m}"
	    if [[ -d "${dir}/files" ]]; then
		for f in $(find "${dir}/files" -type f); do
		    local v=${f##*/}
		    sed -i -e "/${v}/d" "${m}"
		done
	    fi
	    sed -i -e '/^$/d' "${m}"
	    [[ ! -s "${m}" ]] && rm -f "${m}"
	fi
    done

    # Ebuild Digests neu erstellen
    for e in $(find . -iname "*.ebuild"); do
	ebuild "${e}" digest 2>/dev/null
    done
    echo "Manifests & Digests aktualisiert."
}

# ---------------------------------------------------------
# 3. Egencache Aktualisierung
# ---------------------------------------------------------
cmd_cache() {
    echo -e "${GREEN}Aktualisiere egencache für Repo: ${REPO_NAME}${NC}"
    egencache --update-pkg-desc-index --update-use-local-desc --repo="${REPO_NAME}"
    egencache --update-changelogs --jobs=24 --repo="${REPO_NAME}"
}

# ---------------------------------------------------------
# 4. Pkgcheck und Gentoo Tree Duplicate Check
# ---------------------------------------------------------
cmd_check() {
    echo -e "${GREEN}Starte QA Checks (pkgcheck)...${NC}"
    /usr/bin/pkgcheck scan --net

    echo -e "${GREEN}Suche nach Duplikaten im offiziellen Gentoo Tree...${NC}"
    GENTOO_DIR="/var/db/repos/gentoo"
    if [[ ! -d "${GENTOO_DIR}" ]]; then
	echo -e "${YELLOW}Warnung: ${GENTOO_DIR} nicht gefunden. Überspringe Duplikat-Check.${NC}"
	return
    fi

    GENTOO_PACKAGES=($(find ${GENTOO_DIR} -mindepth 2 -maxdepth 2 -printf "%P\n" | sort | grep -Ev "^(.git|.github|metadata|profiles|scripts)/|metadata.xml"))
    REPO_PACKAGES=($(find . -mindepth 2 -maxdepth 2 -printf "%P\n" | sort | grep -Ev "^(.git|.github|metadata|profiles|scripts)/|metadata.xml"))

    for GENTOO_PKG in "${GENTOO_PACKAGES[@]}"; do
	GENTOO_CATEGORIES+=( "${GENTOO_PKG%%/*}" )
	GENTOO_PKG_NAME=${GENTOO_PKG##*/}
	GENTOO_PKG_NAME=${GENTOO_PKG_NAME,,}
	GENTOO_PKG_NAME=${GENTOO_PKG_NAME/[-_]/}
	GENTOO_PKG_NAMES+=( "${GENTOO_PKG_NAME}" )
    done

    PKG_EXACT_MATCH=""
    PKG_CATEGORY_MATCH=""
    PKG_SPECULATIVE_MATCH=""

    for REPO_PKG in "${REPO_PACKAGES[@]}"; do
	REPO_PKG_CATEGORY=${REPO_PKG%%/*}
	REPO_PKG_NAME=${REPO_PKG##*/}
	REPO_PKG_NAME=${REPO_PKG_NAME,,}
	REPO_PKG_NAME=${REPO_PKG_NAME/[-_]/}

	if [[ " ${GENTOO_PKG_NAMES[*]} " =~ " ${REPO_PKG_NAME} " ]]; then
	    local index=()
	    for (( i=0; i<${#GENTOO_PKG_NAMES[@]}; i++ )); do
		[[ "${GENTOO_PKG_NAMES[$i]}" == "${REPO_PKG_NAME}" ]] && index+=( $i )
	    done

	    for i in "${index[@]}"; do
		if [[ "${GENTOO_PACKAGES[$i]}" == "${REPO_PKG}" ]]; then
		    PKG_EXACT_MATCH+="\t${REPO_PKG}::${REPO_NAME} EXACT MATCH of ${GENTOO_PACKAGES[$i]}::gentoo\n"
		    break
		elif [[ "${GENTOO_CATEGORIES[$i]}" == "${REPO_PKG_CATEGORY}" ]]; then
		    PKG_CATEGORY_MATCH+="\t${REPO_PKG}::${REPO_NAME} possible duplicate of ${GENTOO_PACKAGES[$i]}::gentoo\n"
		else
		    PKG_SPECULATIVE_MATCH+="\t${REPO_PKG}::${REPO_NAME} possible duplicate of ${GENTOO_PACKAGES[$i]}::gentoo\n"
		fi
	    done
	fi
    done

    [[ -n ${PKG_SPECULATIVE_MATCH} ]] && echo -e "\n${YELLOW}WARNING (Similar names):${NC}\n${PKG_SPECULATIVE_MATCH}"
    [[ -n ${PKG_CATEGORY_MATCH} ]] && echo -e "\n${YELLOW}WARNING (Same Category):${NC}\n${PKG_CATEGORY_MATCH}"
    if [[ -n ${PKG_EXACT_MATCH} ]]; then
	echo -e "\n${RED}ERROR (Overrides Gentoo Main Tree):${NC}\n${PKG_EXACT_MATCH}"
	exit 1
    fi
    echo "Check abgeschlossen."
}

# ---------------------------------------------------------
# 5. Berechtigungen setzen und Commit & Push
# ---------------------------------------------------------
cmd_upload() {
    echo -e "${GREEN}Setze Berechtigungen (chown portage:portage)...${NC}"
    # Nur ausführen, wenn root/sudo verfugbar, ansonsten warnen
    if [[ "${EUID}" -eq 0 ]]; then
	chown -R portage:portage .
    else
	sudo chown -R portage:portage . || echo -e "${YELLOW}Berechtigungen konnten nicht gesetzt werden (fehlende Rechte).${NC}"
    fi

    echo -e "${GREEN}Lade Änderungen zu GitHub hoch...${NC}"
    read -p "Wie lautet die Commit-Beschreibung? " commitid
    [[ -z "$commitid" ]] && commitid="Updated overlay $(date +"%Y-%m-%d %H:%M")"

    git add .
    git commit -S -m "$commitid"
    git push origin master
    echo -e "${GREEN}Upload abgeschlossen!${NC}"
}

# ---------------------------------------------------------
# 6. Reinit (Git Historie löschen)
# ---------------------------------------------------------
cmd_reinit() {
    local remote_url=$(git remote get-url origin 2>/dev/null)
    if [[ -z "$remote_url" ]]; then
	echo -e "${RED}Fehler: Konnte keine Git Remote-URL finden.${NC}"
	exit 1
    fi

    echo -e "${RED}ACHTUNG: Das Repository (${remote_url}) wird komplett reinitialisiert!${NC}"
    read -t 15 -n 1 -p "Bist du sicher? [y/N] " answer
    echo ""

    if [[ "${answer,,}" == "y" ]]; then
	echo -e "${GREEN}Lösche .git Ordner...${NC}"
	rm -rf .git

	# .gitignore absichern
	rm -f .gitignore
	cat <<EOF >.gitignore
.gitignore
${SCRIPT_NAME}
EOF
	echo -e "${GREEN}Initialisiere neu...${NC}"
	git init
	git add .
	git commit -S -m "Initial commit"
	git branch -M master
	git remote add origin "$remote_url"
	git push -u --force origin master
	echo -e "${GREEN}Reinitialisierung abgeschlossen!${NC}"
    else
	echo "Abgebrochen."
    fi
}

# ---------------------------------------------------------
# 7. Metadata generieren (Remote-IDs & Upstream)
# ---------------------------------------------------------
cmd_metadata() {
    echo -e "${GREEN}Generiere/Aktualisiere metadata.xml (Remote-IDs)...${NC}"

    for category_dir in ./*/; do
	# Ignoriere Git, Profiles und Eclass Ordner
	[[ ! -d "${category_dir}" || "${category_dir}" == *"eclass/"* || "${category_dir}" == *"profiles/"* || "${category_dir}" == *"metadata/"* || "${category_dir}" == *".git/"* ]] && continue

	for pkg_dir in "${category_dir}"*/; do
	    [[ ! -d "${pkg_dir}" ]] && continue

	    ebuild=$(ls "${pkg_dir}"*.ebuild 2>/dev/null | head -n 1)
	    [[ -z "${ebuild}" ]] && continue

	    meta="${pkg_dir}metadata.xml"

	    # Wenn keine metadata.xml existiert, Basis-Struktur anlegen
	    if [[ ! -f "${meta}" ]]; then
		cat <<EOF > "${meta}"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pkgmetadata SYSTEM "https://www.gentoo.org/dtd/metadata.dtd">
<pkgmetadata>
  <maintainer type="person">
    <email>spikyatlinux@gmail.com</email>
    <name>SpikyAtLinux</name>
  </maintainer>
</pkgmetadata>
EOF
	    fi

	    # IDs mit Regex aus Ebuild fischen
	    github_id=$(grep -ioE 'github\.com/[a-z0-9_.-]+/[a-z0-9_.-]+' "${ebuild}" | head -n 1 | cut -d/ -f2,3 | sed 's/\.git$//')
	    gitlab_id=$(grep -ioE 'gitlab\.com/[a-z0-9_.-]+/[a-z0-9_.-]+' "${ebuild}" | head -n 1 | cut -d/ -f2,3 | sed 's/\.git$//')
	    codeberg_id=$(grep -ioE 'codeberg\.org/[a-z0-9_.-]+/[a-z0-9_.-]+' "${ebuild}" | head -n 1 | cut -d/ -f2,3 | sed 's/\.git$//')

	    # PyPI ID suchen
	    pypi_id=$(grep -ioE 'pypi\.org/project/[a-z0-9_.-]+' "${ebuild}" | head -n 1 | cut -d/ -f3 | sed 's/\/$//')
	    if [[ -z "$pypi_id" ]] && grep -qi 'pythonhosted\.org' "${ebuild}"; then
		# Wenn pythonhosted genutzt wird, entspricht die PyPI-ID meist dem Paketnamen
		pypi_id=$(basename "${pkg_dir}")
	    fi

	    # Helper-Funktion zum Einfügen in die XML
	    insert_remote() {
		local type="$1"
		local id="$2"
		[[ -z "$id" ]] && return

		# <upstream> Block erstellen falls nicht existent
		if ! grep -q "<upstream>" "${meta}"; then
		    sed -i '/<\/pkgmetadata>/i \ \ <upstream>\n  </upstream>' "${meta}"
		fi

		# Remote-ID einfügen, falls für diesen Typ noch nicht vorhanden
		if ! grep -q "remote-id type=\"${type}\"" "${meta}"; then
		    sed -i "/<\/upstream>/i \ \ \ \ <remote-id type=\"${type}\">${id}<\/remote-id>" "${meta}"
		fi
	    }

	    # Gefundene IDs in die metadata.xml schreiben
	    insert_remote "github" "${github_id}"
	    insert_remote "gitlab" "${gitlab_id}"
	    insert_remote "codeberg" "${codeberg_id}"
	    insert_remote "pypi" "${pypi_id}"
	done
    done

    echo "Metadaten (Remote-IDs) erfolgreich generiert!"
}

# ---------------------------------------------------------
# Main Routing
# ---------------------------------------------------------
# Wenn keine Argumente übergeben wurden, zeige die Hilfe
if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

# Alle übergebenen Argumente nacheinander abarbeiten
for arg in "$@"; do
    case "$arg" in
	format)   cmd_format ;;
	manifest) cmd_manifest ;;
	metadata) cmd_metadata ;;
	cache)    cmd_cache ;;
	check)    cmd_check ;;
	upload)   cmd_upload ;;
	reinit)   cmd_reinit ;;
	all)
	    cmd_format
        cmd_manifest
	    cmd_metadata
	    cmd_cache
	    echo -e "${GREEN}Alle Vorbereitungen abgeschlossen! Du kannst jetzt './$SCRIPT_NAME upload' ausführen.${NC}"
	    ;;
	*)
	    echo -e "${RED}Fehler: Unbekannter Befehl '$arg'${NC}"
	    show_help
	    exit 1
	    ;;
    esac
    # Eine kleine Leerzeile zur besseren Lesbarkeit zwischen mehreren Befehlen
    echo ""
done
